APP_NAME="Family Photo Archive"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WEB_URL=http://localhost:3010
CORS_ALLOWED_ORIGINS=http://localhost:3010
SANCTUM_STATEFUL_DOMAINS=localhost:3010
INVITATION_LIFETIME_DAYS=7
INVITATION_CLAIM_LIFETIME_MINUTES=15
COMPROMISED_PASSWORD_CHECK_ENABLED=true
COMPROMISED_PASSWORD_CHECK_TIMEOUT=1.5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
# Keep false while legacy bcrypt hashes migrate transparently after successful login.
HASH_VERIFY=false
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=fambam-api
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
OTEL_PROPAGATORS=tracecontext,baggage

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fambam
DB_USERNAME=fambam_app
DB_PASSWORD=fambam_app
DB_RUNTIME_USERNAME=fambam_app
FAMILY_SPACE_DELETION_GRACE_DAYS=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Omit SESSION_SECURE_COOKIE to use the environment-aware default; production defaults to true.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sqs
SQS_PREFIX=http://localstack:4566/000000000000
SQS_QUEUE=image-analysis-requested
SQS_ENDPOINT=http://localstack:4566

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="archive@fambam.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=fambam-media
AWS_ENDPOINT=http://localstack:4566
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
