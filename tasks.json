{
  "project": {
    "id": "family-photo-archive",
    "name": "Family Photo Archive",
    "description": "A private, family-centred photo and memory platform for international relatives who want to share and preserve photographs without relying on mainstream social media.",
    "version": "0.1.0",
    "status": "planned",
    "v1_release_phase": "P15",
    "current_phase": "P00",
    "current_stage": "FPA-P00-S03",
    "created_at": "2026-07-31",
    "updated_at": "2026-08-01"
  },
  "conventions": {
    "phase_id_format": "P##",
    "stage_id_format": "FPA-P##-S##",
    "git_tagging": {
      "phase_tag_format": "phase-<n>",
      "stage_tag_format": "phase-<n>-s<NN>",
      "definition": "Git tags map directly onto PROJECT_ROADMAP.md / docs/IMPLEMENTATION_GUIDE.md identifiers. <n> is the roadmap phase number (Phase P<n> -> phase-<n>) and <NN> is the roadmap stage number within that phase (FPA-P<n>-S<NN> -> phase-<n>-s<NN>). ADR numbers never determine git phase numbers. This matches the convention documented and used in the sibling dolved project.",
      "tagging_rules": [
        "Only a completed planned roadmap stage receives a phase-<n>-s<NN> tag.",
        "Intermediate commits made while a stage is still in progress receive no stage tag.",
        "The stage tag is applied to the single commit that completes the planned roadmap stage.",
        "If a stage's entire scope is accepting an ADR, the ADR-acceptance commit is that stage's completion commit and receives the tag directly.",
        "Otherwise, an ADR-acceptance commit remains untagged until the authorised implementation stage that follows it is itself completed and accepted.",
        "phase-<n> (no stage suffix) is created only once, on the commit that completes that phase's final stage and passes the phase's full acceptance gate."
      ],
      "roadmap_relationship": "PROJECT_ROADMAP.md phase identifiers (P##) and docs/IMPLEMENTATION_GUIDE.md stage identifiers (FPA-P##-S##) are the direct source of the tag numbers -- this is the same numbering, not a parallel scheme. The delivery_log array (top level of this file) records every tag actually produced, mapped to its roadmap stage."
    },
    "statuses": [
      "planned",
      "ready",
      "in_progress",
      "blocked",
      "completed",
      "cancelled"
    ],
    "documentation": {
      "roadmap": "PROJECT_ROADMAP.md",
      "implementation_guide": "docs/IMPLEMENTATION_GUIDE.md",
      "adrs": "docs/adr/",
      "journal": "docs/journal/"
    },
    "completion_rules": [
      "Required verification passes.",
      "Required documentation is updated.",
      "tasks.json is advanced in the same commit.",
      "The commit remains within the agreed stage boundary."
    ]
  },
  "phases": [
