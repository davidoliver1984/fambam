# Local Docker Compose ports
WEB_PORT=3010
API_PORT=8082
IMAGE_AI_PORT=8010
POSTGRES_PORT=5434
REDIS_PORT=6380
LOCALSTACK_PORT=4570
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
GRAFANA_PORT=3011
OTEL_GRPC_PORT=4327
OTEL_HTTP_PORT=4328

# Safe local-only development values
POSTGRES_DB=fambam
POSTGRES_USER=fambam
POSTGRES_PASSWORD=fambam
DB_RUNTIME_USERNAME=fambam_app
DB_RUNTIME_PASSWORD=fambam_app
FAMILY_SPACE_DELETION_GRACE_DAYS=14
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=fambam-media
AWS_PUBLIC_ENDPOINT=http://localhost:4570
MEDIA_UPLOAD_AUTHORITY_TTL_MINUTES=15
MEDIA_DELIVERY_AUTHORITY_TTL_MINUTES=5
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_MAX_PIXELS=100000000
MEDIA_DECODER_TIMEOUT_SECONDS=20
MEDIA_ABANDONED_AFTER_HOURS=24
CLAMAV_TIMEOUT_SECONDS=30
MEDIA_QUARANTINE_RETENTION_DAYS=7
MEDIA_PROCESSING_TIMEOUT_SECONDS=30
MEDIA_METADATA_PROFILE_MAX_BYTES=33554432
MEDIA_CANONICAL_JPEG_QUALITY=90
FACE_ANALYSIS_RESULT_MAX_BYTES=4194304
FACE_ANALYSIS_AUTHORITY_TTL_MINUTES=60
FACE_ANALYSIS_ATTEMPT_STALE_MINUTES=5
FACE_ANALYSIS_MAX_ATTEMPTS_PER_RUN=3
FACE_ANALYSIS_INFERENCE_TIMEOUT_SECONDS=20
FACE_ANALYSIS_RESULT_MAX_FACES=256
FACE_ANALYSIS_RESULT_MAX_JSON_DEPTH=8
FACE_ANALYSIS_PROVIDER_DIAGNOSTICS_MAX_BYTES=16384
VITE_API_BASE_URL=http://localhost:8082
INVITATION_LIFETIME_DAYS=7
EVENT_ADMISSION_LIFETIME_DAYS=30
EVENT_EXPORT_LIFETIME_HOURS=24
EVENT_EXPORT_DOWNLOAD_TTL_MINUTES=5
INVITATION_CLAIM_LIFETIME_MINUTES=15
COMPROMISED_PASSWORD_CHECK_ENABLED=true
COMPROMISED_PASSWORD_CHECK_TIMEOUT=1.5
HASH_DRIVER=argon2id
# Required while existing bcrypt hashes migrate on successful login.
HASH_VERIFY=false

# Generate a different local value with: php apps/api/artisan key:generate --show
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
